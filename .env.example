# Environment Variables
# Copy this file to .env and fill in values

# ── Database ──────────────────────────────
# SQLite (local development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — uncomment and configure:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── App ───────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Hillwalking Rental"

# ── Email / SMTP (for verification + password reset) ──
# Leave empty for dev mode (links shown in console)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@hillwalking-rental.example.com"

# ── Google OAuth ──────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cloudinary (image upload) ─────────────
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="hillwalking-rental"

# ── Supabase Storage (alternative to Cloudinary) ──
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="item-images"

# ── Feature Flags ─────────────────────────
# Set to "true" to enable real payment processing (default: false)
ENABLE_REAL_PAYMENTS="false"
# Set to "false" to skip email verification in dev (default: true)
ENABLE_EMAIL_VERIFICATION="true"
# Set to "false" to disable public registration (default: true)
PUBLIC_REGISTRATION_ENABLED="true"

# ── Admin Bootstrap ───────────────────────
# First registered admin email (auto-promoted to ADMIN role)
ADMIN_EMAIL="admin@example.com"
