# ── Database ──────────────────────────────
# SQLite (local development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — uncomment and configure:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── App ───────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Hillwalking Rental"
NODE_ENV="development"

# ── Auth / Session ────────────────────────
# Used for session cookie encryption
NEXTAUTH_SECRET="replace-with-secure-random-secret-minimum-32-chars"

# ── Email / SMTP (for verification + password reset) ──
# In dev mode without SMTP, verification/reset links are shown in the console
# and returned in the API response for manual testing.
# For production, configure a real SMTP provider (Resend, SendGrid, AWS SES, etc.)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Hillwalking Rental <no-reply@example.com>"

# ── Google OAuth ──────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Local callback: http://localhost:3000/api/auth/callback/google
# Production callback: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cloudinary (image upload) ─────────────
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="hillwalking-rental"

# ── Feature Flags ─────────────────────────
# Set to "true" to enable real payment processing (not recommended for launch)
ENABLE_REAL_PAYMENTS="false"
# Set to "false" to skip email verification in dev
ENABLE_EMAIL_VERIFICATION="true"
# Set to "false" to disable public registration
PUBLIC_REGISTRATION_ENABLED="true"

# ── Admin Bootstrap ───────────────────────
# First email registered with this address is auto-promoted to ADMIN
ADMIN_EMAIL="admin@example.com"

# ── Optional: Rate Limiting (production) ──
# In-memory rate limiting is used by default.
# For production with multiple server instances, use Upstash Redis:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
