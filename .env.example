# ── 数据库 ──────────────────────────────
# 本地开发 (SQLite)
DATABASE_URL="file:./dev.db"

# 生产环境 (PostgreSQL) — 取消注释并填入你的数据库连接信息:
# 在 Supabase 创建项目后，复制这个格式的连接字符串
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# ── 应用 ────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Hillwalking Rental"
NODE_ENV="development"

# ── 会话加密 ────────────────────────────
# 随机生成一串字符即可 (32位以上)
NEXTAUTH_SECRET="replace-with-a-random-string-at-least-32-characters"

# ── 邮箱 SMTP（验证邮箱 + 重置密码） ──
# 如果没有 SMTP，开发环境下会自动显示验证链接
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Hillwalking Rental <no-reply@example.com>"

# ── Google 登录 ─────────────────────────
# 在 https://console.cloud.google.com/apis/credentials 创建 OAuth 2.0 客户端
# 本地回调地址: http://localhost:3000/api/auth/callback/google
# 生产回调地址: https://你的域名.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cloudinary 图片存储 ─────────────────
# 在 https://cloudinary.com/console 免费注册获取
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="hillwalking-rental"

# ── 功能开关 ────────────────────────────
ENABLE_REAL_PAYMENTS="false"
ENABLE_EMAIL_VERIFICATION="true"
PUBLIC_REGISTRATION_ENABLED="true"

# ── 管理员 ──────────────────────────────
ADMIN_EMAIL="admin@example.com"
